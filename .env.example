# Courtly local secrets. Copy to .env and fill only what you have.
# Never commit real keys.

# Public URL ElevenLabs will call (ngrok / deployed host).
PUBLIC_BASE_URL=http://localhost:8080

# Shared secret for POST /api/voice/tools/*. Change before any public tunnel.
TOOL_WEBHOOK_SECRET=change-me-tool-webhook-secret

# ElevenLabs agent (leave empty until the phone number is wired).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Optional SMS providers. Default runtime is log-only.
SMS_FROM=Courtly
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
SMSAPI_TOKEN=

# Optional Twilio inbound, if you skip ElevenLabs-managed numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
