# Courtly voice/SMS/SIP secrets. Copy to .env. Never commit real keys.
# Rotate independently from the AI receptionist project. Do not reuse that number.

# Public URL ElevenLabs will call (ngrok / deployed host).
PUBLIC_BASE_URL=http://localhost:8080

# Shared secret for POST /api/voice/tools/* and /api/voice/provision.
TOOL_WEBHOOK_SECRET=change-me-tool-webhook-secret

# Teammate fills this ElevenLabs account (not the receptionist workspace if you keep those separate).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Telnyx: use the spare SIP number for Courtly. Leave the receptionist DID untouched.
# After the demo you can rotate these.
VOICE_TELEPHONY_PROVIDER=telnyx
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SMS_FROM=Courtly
TELNYX_PUBLIC_KEY=
TELNYX_FQDN_CONNECTION_ID=
TELNYX_TEXML_APP_ID=
SIP_TERMINATION_URI=sip:sip.rtc.elevenlabs.io:5060;transport=tcp
SIP_USERNAME=
SIP_PASSWORD=
SIP_FROM_NUMBER=

# Unused unless you skip Telnyx SIP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMSAPI_TOKEN=
