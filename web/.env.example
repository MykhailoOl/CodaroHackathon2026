# Base URL of the Spring Boot API. Every request sends
# `Authorization: Bearer <token>` once logged in.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Set to "true" to force the whole app onto lib/fixtures.ts and never call
# the real API, even if it's reachable. Leave unset/false to call the live
# API and fall back to fixtures automatically only on error. There is also a
# runtime "Use demo data" checkbox on the login/composer screens that does
# the same thing without a rebuild.
NEXT_PUBLIC_USE_FIXTURES=false

# Placeholder text in the composer textarea. THE PIVOT SEAM: retargeting to a
# new niche changes this without touching code. lib/fixtures.ts is the demo
# data shown when the backend is down — swap its content wholesale per niche.
NEXT_PUBLIC_DEMO_INTENT=my father died yesterday, orthodox service, about 40 mourners
